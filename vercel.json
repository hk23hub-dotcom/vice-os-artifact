{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/scale-push.js": {
      "maxDuration": 60
    },
    "api/centro-postular.js": { "maxDuration": 120 },
    "api/centro-admin.js": { "maxDuration": 120 },
    "api/centro-correr.js": { "maxDuration": 60 },
    "api/centro-pase.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/centro-admin(.html)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/gta6-research",
      "schedule": "0 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/hk23-universe",
      "destination": "/universe-os",
      "permanent": false
    },
    {
      "source": "/agent-os",
      "destination": "https://hk23hub.gumroad.com/l/agentos",
      "permanent": false
    },
    {
      "source": "/agentos",
      "destination": "https://hk23hub.gumroad.com/l/agentos",
      "permanent": false
    },
    {
      "source": "/agent",
      "destination": "https://hk23hub.gumroad.com/l/agentos",
      "permanent": false
    },
    {
      "source": "/designer",
      "destination": "/agent-designer",
      "permanent": false
    },
    {
      "source": "/try",
      "destination": "/agent-designer",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/universe-os",
      "destination": "/universe-os.html"
    },
    {
      "source": "/g/:slug",
      "destination": "/universe-os.html?g=:slug"
    },
    {
      "source": "/frequency",
      "destination": "/universe-os.html?g=frequency"
    },
    {
      "source": "/jc",
      "destination": "/universe-os.html?g=frequency"
    }
  ]
}
